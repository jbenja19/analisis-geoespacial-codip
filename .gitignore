# ==========================================
# DATOS REALES
# ==========================================
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Formatos de datos que no deben versionarse por defecto
*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.gpkg

# ==========================================
# ENTORNOS VIRTUALES
# ==========================================
.venv/
venv/
env/
.conda/

# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ==========================================
# JUPYTER
# ==========================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ==========================================
# VARIABLES DE ENTORNO Y SECRETOS
# ==========================================
.env
*.env
!.env.example

# ==========================================
# ARTEFACTOS DE MODELOS FUTUROS
# ==========================================
*.pkl
*.joblib
*.h5
*.pt
*.pth

# ==========================================
# IDEs / SISTEMA
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# LOGS / CACHE
# ==========================================
logs/
*.log
.dvc/cache
/tmp
